{
  "name": "onflip",
  "version": "0.2.0",
  "description": "OnFlip — an autonomous coding agent CLI driven by your ChatGPT web session",
  "license": "MIT",
  "author": "Farrukh Khudayarovich Yuldashev",
  "homepage": "https://github.com/khudayarovich/onflip-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khudayarovich/onflip-agent.git"
  },
  "bugs": {
    "url": "https://github.com/khudayarovich/onflip-agent/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "chatgpt",
    "coding-agent",
    "tui",
    "pair-programming"
  ],
  "bin": {
    "onflip": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "browser": "playwright install chromium",
    "check-version": "node scripts/sync-version.js --check",
    "version": "node scripts/sync-version.js && git add src/repl.ts",
    "prepare": "npm run build",
    "postinstall": "node scripts/postinstall.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chalk": "^4.1.2",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
